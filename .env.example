# 复制为 .env 后按需修改（无密钥，均为本地端口/路径配置）
BACKEND_PORT=8000
FRONTEND_PORT=5173
# 后端 SQLite 文件路径（默认 backend/data/agent_guard.db；docker 内为 /data/agent_guard.db）
# AGENT_GUARD_DB_PATH=

# ---- 真实 LLM Agent（OpenAI-compatible，可选）----
# 默认指向 SiliconFlow；开发期 key 为空，仅演示模式 + 本地 stub 可用。
# Mac 验收时如需真实 LLM，由用户本人把 key 填进 .env（.env 已 gitignore，绝不提交）。
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
# LLM_API_KEY=

# MCP / LLM 调用等待人工审批的超时秒数（超时只返回错误，不自动拒绝，审批单继续有效）
GUARD_APPROVAL_TIMEOUT=300

# ---- 管理口令（可选，默认关闭）----
# 设置后，管理接口（/api/admin/stop|resume|reset）与审批决议（/api/approvals/{id}/decide）
# 要求请求头 X-Admin-Token 匹配，否则 401。前端顶栏"管理口令"输入框填入后自动携带。
# 未设置时保持现状（本机演示零负担）。
# GUARD_ADMIN_TOKEN=

# ---- 真实邮件发送（可选，默认关闭）----
# mail.send 默认只写本地 outbox 模拟表（不触网）。如需真实发送：
# 1. REAL_MAIL_ENABLED=1；2. 填 SMTP_*；3. REAL_MAIL_ALLOWLIST 填允许的收件地址（逗号分隔）。
# 启用后：只允许白名单地址，其他一律拒绝并记 blocked 记录；缺任何 SMTP 配置同样拒绝。
# 真实发出后 outbox 行标记 real_sent=1，审计记 mail.real_sent 事件（to/subject，不记正文）。
# SMTP_PASS 只从本文件读取，不进日志/审计/仓库（.env 已 gitignore）。
REAL_MAIL_ENABLED=0
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=user@example.com
# SMTP_PASS=<redacted>
# SMTP_FROM=user@example.com
# REAL_MAIL_ALLOWLIST=you@example.com,friend@example.com

# ---- 真实 LLM 成本熔断（预算守卫，默认保守）----
# 单轮最大步数（每步 = 1 次 API 调用）；开发期 stub 同样受此约束
LLM_MAX_STEPS=12
# 每天真实 API 调用上限（本地 stub 不计费、不计入）；超限后 /run-llm 拒绝、循环中终止
LLM_DAILY_MAX_CALLS=50
# 紧急停止开关：=1 时禁用真实 LLM 入口（/run-llm 直接 409），不启动任何线程
LLM_KILL_SWITCH=0
